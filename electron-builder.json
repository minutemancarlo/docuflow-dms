{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.docuflow.dms",
  "productName": "DocuFlow DMS",
  "copyright": "Copyright © 2026 DocuFlow DMS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png",
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "DocuFlow-DMS-${version}-Portable.exe"
  }
}
